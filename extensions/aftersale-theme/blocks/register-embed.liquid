{% comment %} Register form embed {% endcomment %}

{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign product_q = '' %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
{% endif %}
{% assign embed_src = as_app_url | append: '/apps/aftersale/register?shop=' | append: shop.permanent_domain | append: '&embed=1' %}
{% if product %}
  {% assign embed_src = embed_src | append: '&product=' | append: product_q | append: '&product_id=' | append: product.id %}
  {% if product.selected_or_first_available_variant %}
    {% assign embed_src = embed_src | append: '&variant_id=' | append: product.selected_or_first_available_variant.id %}
  {% endif %}
{% endif %}
{% if customer and customer.email != blank %}
  {% assign embed_src = embed_src | append: '&email=' | append: customer.email %}
{% endif %}

<div class="as-embed-block" {{ block.shopify_attributes }} data-as-embed>
  {% if request.design_mode %}
    <div class="as-block-preview">
      <strong>Register for warranty</strong>
      <p>Customers activate coverage for this product.</p>
      <span class="as-block-preview__field">Email</span>
      <span class="as-block-preview__field">Order number</span>
      <span class="as-block-preview__btn">Register product</span>
      <a class="as-block-preview__link" href="{{ embed_src }}" target="_blank" rel="noopener">Open live preview ↗</a>
    </div>
  {% endif %}
  <iframe
    class="as-embed-block__frame{% if request.design_mode %} as-embed-block__frame--editor{% endif %}"
    title="{{ block.settings.title | default: 'Register warranty' }}"
    src="{{ embed_src }}"
    style="width:100%;min-height:{{ block.settings.min_height }}px;border:0;"
    loading="lazy"
    allow="clipboard-write"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>

{% schema %}
{
  "name": "Register form embed",
  "target": "section",
  "stylesheet": "aftersale.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Embedded registration form. Theme editor shows a preview card — open live preview to click through."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Iframe title (accessibility)",
      "default": "Register warranty"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (px)",
      "min": 400,
      "max": 1200,
      "step": 40,
      "default": 720
    }
  ]
}
{% endschema %}
