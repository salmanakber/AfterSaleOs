{% comment %}
  Embeds product registration via hosted app URL + editor preview card.
{% endcomment %}

{% capture as_app_url %}{% render 'as-app-host', url: block.settings.app_url %}{% endcapture %}
{% assign as_app_url = as_app_url | strip %}
{% assign product_q = '' %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
{% endif %}
{% assign embed_src = as_app_url | append: '/apps/aftersale/register?shop=' | append: shop.permanent_domain | append: '&embed=1' %}
{% if product %}
  {% assign embed_src = embed_src | append: '&product=' | append: product_q | append: '&product_id=' | append: product.id %}
  {% if product.selected_or_first_available_variant %}
    {% assign embed_src = embed_src | append: '&variant_id=' | append: product.selected_or_first_available_variant.id %}
  {% endif %}
{% endif %}

<div class="as-embed-block" {{ block.shopify_attributes }} data-as-embed>
  <div class="as-embed-mock" data-as-embed-mock aria-hidden="false">
    <div class="as-embed-mock__bar">
      <span></span><span></span><span></span>
      <em>Register warranty · preview</em>
    </div>
    <div class="as-embed-mock__body">
      <strong>Register your product</strong>
      <p>Activate coverage in under a minute. Customers fill email, order, and serial here.</p>
      <div class="as-embed-mock__fields">
        <i></i><i></i><i></i>
      </div>
      <span class="as-embed-mock__btn">Register product</span>
      <a class="as-embed-mock__link" href="{{ embed_src }}" target="_blank" rel="noopener">Open full form ↗</a>
    </div>
  </div>
  <iframe
    class="as-embed-block__frame"
    title="{{ block.settings.title | default: 'Register warranty' }}"
    src="{{ embed_src }}"
    style="width:100%;min-height:{{ block.settings.min_height }}px;border:0;border-radius:12px;background:#f8fafc;"
    loading="eager"
    allow="clipboard-write"
    referrerpolicy="no-referrer-when-downgrade"
    data-as-embed-frame
  ></iframe>
</div>

<script src="{{ 'as-embed.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "AfterSale register embed",
  "target": "section",
  "stylesheet": "aftersale.css",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL (hosted AfterSale)",
      "default": "https://aftersale.tidyflowapp.com",
      "info": "Use https://aftersale.tidyflowapp.com — never your .myshopify.com domain."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Iframe title (accessibility)",
      "default": "Register warranty"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (px)",
      "min": 400,
      "max": 1200,
      "step": 40,
      "default": 720
    }
  ]
}
{% endschema %}
