{% comment %}
  App embed — enable once: Theme settings → App embeds → Warranty opt-in
  Checkbox only: marks the order for automatic warranty after checkout.
  Does NOT open the registration portal.
{% endcomment %}

{% assign accent = block.settings.accent_color | default: '#0f172a' %}
{% assign surface = block.settings.surface_color | default: '#ffffff' %}
{% assign radius = block.settings.corner_radius | default: 12 %}
{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign fee_api = as_app_url | append: '/api/public/branding' %}
{% assign mount_on = '' %}

{% if template.name == 'product' and product %}
  {% assign mount_on = 'product' %}
{% elsif template.name == 'cart' %}
  {% assign mount_on = 'cart' %}
{% endif %}

{% if mount_on != blank %}
  <div
    id="as-optin-embed-root"
    class="as-optin as-optin--embed as-optin--checkbox_card"
    style="--as-optin-accent: {{ accent }}; --as-optin-surface: {{ surface }}; --as-optin-radius: {{ radius }}px; display:none;"
    {{ block.shopify_attributes }}
    data-as-optin
    data-as-embed-mount
    data-as-mount="{{ mount_on }}"
    data-as-style="checkbox_card"
    data-shop="{{ shop.permanent_domain }}"
    data-fee-api="{{ fee_api }}"
    data-checked-status="{{ block.settings.checked_hint | default: 'Warranty will be registered automatically when you complete checkout.' | escape }}"
  >
    <div class="as-optin__card" data-as-optin-card>
      <span class="as-optin__checkwrap">
        <input
          id="as-optin-check-{{ block.id }}"
          class="as-optin__checkbox"
          type="checkbox"
          name="attributes[aftersale_register_intent]"
          value="yes"
          data-as-optin-check
          {% if block.settings.default_checked %}checked{% endif %}
        />
        <span class="as-optin__box" aria-hidden="true"></span>
      </span>
      <span class="as-optin__copy">
        <label class="as-optin__title" for="as-optin-check-{{ block.id }}">{{ block.settings.title }}</label>
        {% if block.settings.subtitle != blank %}
          <span class="as-optin__sub">{{ block.settings.subtitle }}</span>
        {% endif %}
        <span class="as-optin__fee" data-as-fee-note hidden></span>
      </span>
    </div>
    <div class="as-optin__panel as-optin__panel--confirm" data-as-optin-panel hidden>
      <p class="as-optin__status" data-as-optin-status role="status"></p>
    </div>
  </div>

  <script src="{{ 'as-optin.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Warranty opt-in (auto)",
  "target": "body",
  "stylesheet": "aftersale.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Checkbox only. Checking it registers warranty automatically after purchase — it never opens another page."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Include free warranty registration"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Supporting text",
      "default": "Check this box to register coverage automatically after you buy."
    },
    {
      "type": "text",
      "id": "checked_hint",
      "label": "Confirmation when checked",
      "default": "Warranty will be registered automatically when you complete checkout."
    },
    {
      "type": "checkbox",
      "id": "default_checked",
      "label": "Checked by default",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0F172A"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ]
}
{% endschema %}
