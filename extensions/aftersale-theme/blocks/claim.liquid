{% comment %} AfterSale claim entry block — hosted URL {% endcomment %}
{% assign as_app_url = block.settings.app_url | default: 'https://aftersale.tidyflowapp.com' | strip | remove_last: '/' %}
{% assign product_q = '' %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
{% endif %}

<div class="as-claim-block" {{ block.shopify_attributes }}>
  <a
    class="as-register-block__btn"
    href="{{ as_app_url }}/apps/aftersale/claim?shop={{ shop.permanent_domain }}{% if product %}&product={{ product_q }}&product_id={{ product.id }}{% endif %}"
  >
    {{ block.settings.button_label | default: "File a warranty claim" }}
  </a>
</div>

{% schema %}
{
  "name": "AfterSale claim",
  "target": "section",
  "stylesheet": "aftersale.css",
  "enabled_on": {
    "templates": ["product", "page", "index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://aftersale.tidyflowapp.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "File a warranty claim"
    }
  ]
}
{% endschema %}
