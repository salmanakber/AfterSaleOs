{% comment %} AfterSale claim entry button {% endcomment %}
{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign accent = block.settings.accent_color | default: '#1a1d26' %}
{% assign product_q = '' %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
{% endif %}

<div class="as-claim-block" style="--as-btn-accent: {{ accent }};" {{ block.shopify_attributes }}>
  <a
    class="as-register-block__btn"
    href="{{ as_app_url }}/apps/aftersale/claim?shop={{ shop.permanent_domain }}{% if product %}&product={{ product_q }}&product_id={{ product.id }}{% endif %}"
  >
    {{ block.settings.button_label | default: "File a warranty claim" }}
  </a>
</div>

{% schema %}
{
  "name": "Warranty claim button",
  "target": "section",
  "stylesheet": "aftersale.css",
  "enabled_on": {
    "templates": ["product", "page", "index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "File a warranty claim"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#1A1D26"
    }
  ]
}
{% endschema %}
