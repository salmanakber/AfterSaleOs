{% comment %} Warranty lookup entry link {% endcomment %}
{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign accent = block.settings.accent_color | default: '#1a1d26' %}

<div class="as-lookup-block" style="--as-btn-accent: {{ accent }};" {{ block.shopify_attributes }}>
  <a class="as-register-block__btn" href="{{ as_app_url }}/apps/aftersale/portal?shop={{ shop.permanent_domain }}">
    {{ block.settings.label | default: "Check your warranty" }}
  </a>
</div>

{% schema %}
{
  "name": "Warranty lookup",
  "target": "section",
  "stylesheet": "aftersale.css",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Link label",
      "default": "Check your warranty"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#1A1D26"
    }
  ]
}
{% endschema %}
