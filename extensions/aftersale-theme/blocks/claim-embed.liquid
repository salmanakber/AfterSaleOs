{% comment %} Claim form embed {% endcomment %}

{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign product_q = '' %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
{% endif %}
{% assign embed_src = as_app_url | append: '/apps/aftersale/claim?shop=' | append: shop.permanent_domain | append: '&embed=1' %}
{% if product %}
  {% assign embed_src = embed_src | append: '&product=' | append: product_q | append: '&product_id=' | append: product.id %}
{% endif %}

<div class="as-embed-block" {{ block.shopify_attributes }} data-as-embed>
  {% if request.design_mode %}
    <div class="as-block-preview">
      <strong>File a warranty claim</strong>
      <p>Customers describe the issue and track status after submit.</p>
      <span class="as-block-preview__field">Email</span>
      <span class="as-block-preview__field">Issue summary</span>
      <span class="as-block-preview__btn">Submit claim</span>
      <a class="as-block-preview__link" href="{{ embed_src }}" target="_blank" rel="noopener">Open live preview ↗</a>
    </div>
  {% endif %}
  <iframe
    class="as-embed-block__frame{% if request.design_mode %} as-embed-block__frame--editor{% endif %}"
    title="{{ block.settings.title | default: 'File a claim' }}"
    src="{{ embed_src }}"
    style="width:100%;min-height:{{ block.settings.min_height }}px;border:0;"
    loading="lazy"
    allow="clipboard-write"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>

{% schema %}
{
  "name": "Claim form embed",
  "target": "section",
  "stylesheet": "aftersale.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Embedded claim form. Use “Open live preview” in the theme editor to test clicks."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Iframe title (accessibility)",
      "default": "File a warranty claim"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (px)",
      "min": 400,
      "max": 1200,
      "step": 40,
      "default": 720
    }
  ]
}
{% endschema %}
