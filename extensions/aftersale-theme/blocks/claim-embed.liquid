{% comment %} Claim form embed — merchant controls columns + width in customizer {% endcomment %}

{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign accent = block.settings.accent_color | default: '#0f172a' %}
{% assign surface = block.settings.surface_color | default: 'transparent' %}
{% assign radius = block.settings.corner_radius | default: 12 %}
{% assign accent_q = accent | url_encode %}
{% assign as_cols = block.settings.form_columns | default: '2' %}
{% assign as_cwidth = block.settings.content_width | default: 'wide' %}
{% assign as_fstyle = block.settings.form_style | default: 'cards' %}
{% case as_cwidth %}
  {% when 'full' %}
    {% assign as_max_w = '100%' %}
  {% when 'wide' %}
    {% assign as_max_w = '960px' %}
  {% when 'medium' %}
    {% assign as_max_w = '720px' %}
  {% when 'compact' %}
    {% assign as_max_w = '520px' %}
  {% else %}
    {% assign as_max_w = '960px' %}
{% endcase %}
{% assign as_layout_qs = '&cols=' | append: as_cols | append: '&width=' | append: as_cwidth | append: '&style=' | append: as_fstyle %}
{% assign product_q = '' %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
{% endif %}
{% comment %} Always load unified portal inside the theme block — never redirect to self-hosted claim. {% endcomment %}
{% assign embed_src = as_app_url | append: '/apps/aftersale/portal?shop=' | append: shop.permanent_domain | append: '&embed=1&theme=local&view=claim&accent=' | append: accent_q | append: as_layout_qs %}
{% if product %}
  {% assign embed_src = embed_src | append: '&product=' | append: product_q | append: '&product_id=' | append: product.id %}
{% endif %}
{% if routes.account_login_url != blank %}
  {% assign as_login_q = routes.account_login_url | url_encode %}
  {% assign embed_src = embed_src | append: '&shopify_login=' | append: as_login_q %}
{% endif %}
{% if request.path != blank %}
  {% assign as_return_q = request.path | url_encode %}
  {% assign embed_src = embed_src | append: '&return_to=' | append: as_return_q %}
{% endif %}
{% if customer and customer.email != blank %}
  {% assign as_email_q = customer.email | url_encode %}
  {% assign embed_src = embed_src | append: '&email=' | append: as_email_q %}
{% endif %}
{% if customer and customer.id %}
  {% assign embed_src = embed_src | append: '&logged_in_customer_id=' | append: customer.id %}
{% endif %}

<div
  class="as-embed-block as-embed-block--{{ as_cwidth }} as-embed-block--cols-{{ as_cols }}"
  {{ block.shopify_attributes }}
  data-as-embed
  style="--as-embed-radius: {{ radius }}px; --as-embed-surface: {{ surface }}; --as-embed-max: {{ as_max_w }};"
>
  {% if request.design_mode %}
    <div class="as-block-preview as-block-preview--form as-block-preview--cols-{{ as_cols }}" style="border-radius: {{ radius }}px; max-width: {{ as_max_w }};">
      <strong>Claim form · {% if as_cols == '1' %}1 column{% else %}2 columns{% endif %} · {{ as_cwidth }}</strong>
      <p>Adjust Form fields, Form width, and Form style in the block settings.</p>
      <div class="as-block-preview__grid as-block-preview__grid--{{ as_cols }}">
        <span class="as-block-preview__field">Email</span>
        <span class="as-block-preview__field">Name</span>
        <span class="as-block-preview__field">Order</span>
        <span class="as-block-preview__field">Serial</span>
      </div>
      <span class="as-block-preview__btn" style="background:{{ accent }};">Submit claim</span>
      <a class="as-block-preview__link" href="{{ embed_src }}" target="_blank" rel="noopener">Open live preview ↗</a>
    </div>
  {% else %}
    <iframe
      class="as-embed-block__frame"
      title="{{ block.settings.title | default: 'File a claim' }}"
      src="{{ embed_src }}"
      data-as-min-height="{{ block.settings.min_height }}"
      style="width:100%;max-width:{{ as_max_w }};min-height:{{ block.settings.min_height }}px;height:{{ block.settings.min_height }}px;border:0;border-radius:{{ radius }}px;background:{{ surface }};margin-inline:auto;display:block;"
      loading="lazy"
      allow="clipboard-write"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  {% endif %}
</div>

{% schema %}
{
  "name": "Claim form embed",
  "target": "section",
  "stylesheet": "aftersale.css",
  "javascript": "as-embed.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Customize how the claim form looks inside this section."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "form_columns",
      "label": "Form fields",
      "options": [
        { "value": "2", "label": "Two columns" },
        { "value": "1", "label": "One column" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Form width",
      "options": [
        { "value": "full", "label": "Full section width" },
        { "value": "wide", "label": "Wide (960px)" },
        { "value": "medium", "label": "Medium (720px)" },
        { "value": "compact", "label": "Compact (520px)" }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "form_style",
      "label": "Form style",
      "options": [
        { "value": "cards", "label": "Section cards" },
        { "value": "flat", "label": "Flat (minimal)" }
      ],
      "default": "cards"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 280,
      "max": 1200,
      "step": 20,
      "default": 720
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Accessible name",
      "default": "File a warranty claim"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0F172A"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Surface / background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ]
}
{% endschema %}
