{% comment %}
  Embeds warranty portal via hosted app URL (not app proxy) so Next.js JS loads correctly.
{% endcomment %}

{% assign as_app_url = block.settings.app_url | default: 'https://aftersale.tidyflowapp.com' | strip | remove_last: '/' %}

<div class="as-embed-block" {{ block.shopify_attributes }}>
  <iframe
    class="as-embed-block__frame"
    title="{{ block.settings.title | default: 'Warranty portal' }}"
    src="{{ as_app_url }}/apps/aftersale/portal?shop={{ shop.permanent_domain }}&embed=1"
    style="width:100%;min-height:{{ block.settings.min_height }}px;border:0;border-radius:12px;background:#f8fafc;"
    loading="lazy"
    allow="clipboard-write"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>

{% schema %}
{
  "name": "AfterSale portal embed",
  "target": "section",
  "stylesheet": "aftersale.css",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL (do not use shop domain)",
      "default": "https://aftersale.tidyflowapp.com",
      "info": "Must be your AfterSale hosting URL so the form can load."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Iframe title (accessibility)",
      "default": "Warranty portal"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (px)",
      "min": 400,
      "max": 1200,
      "step": 40,
      "default": 720
    }
  ]
}
{% endschema %}
