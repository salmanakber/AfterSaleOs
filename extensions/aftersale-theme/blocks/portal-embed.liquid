{% comment %} Portal form embed — 100% parent width; theme-local colors only {% endcomment %}

{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign accent = block.settings.accent_color | default: '#0f172a' %}
{% assign surface = block.settings.surface_color | default: 'transparent' %}
{% assign radius = block.settings.corner_radius | default: 0 %}
{% assign accent_q = accent | url_encode %}
{% assign embed_src = as_app_url | append: '/apps/aftersale/portal?shop=' | append: shop.permanent_domain | append: '&embed=1&theme=local&accent=' | append: accent_q %}
{% if customer and customer.email != blank %}
  {% assign as_email_q = customer.email | url_encode %}
  {% assign embed_src = embed_src | append: '&email=' | append: as_email_q %}
{% endif %}
{% if customer and customer.id %}
  {% assign embed_src = embed_src | append: '&logged_in_customer_id=' | append: customer.id %}
{% endif %}

<div
  class="as-embed-block"
  {{ block.shopify_attributes }}
  data-as-embed
  style="--as-embed-radius: {{ radius }}px; --as-embed-surface: {{ surface }}; width:100%; max-width:100%;"
>
  {% if request.design_mode %}
    <div class="as-block-preview as-block-preview--slim" style="border-radius: {{ radius }}px;">
      <div class="as-block-preview__col">
        <span class="as-block-preview__kicker">Warranty</span>
        <strong>Warranty portal</strong>
        <p>Look up coverage with email and order number.</p>
      </div>
      <div class="as-block-preview__col as-block-preview__col--form">
        <span class="as-block-preview__field">Email</span>
        <span class="as-block-preview__field">Order number</span>
        <span class="as-block-preview__btn" style="background:{{ accent }};">Open my warranties</span>
      </div>
      <a class="as-block-preview__link" href="{{ embed_src }}" target="_blank" rel="noopener">Open live preview ↗</a>
    </div>
  {% else %}
    <iframe
      class="as-embed-block__frame"
      title="{{ block.settings.title | default: 'Warranty portal' }}"
      src="{{ embed_src }}"
      style="width:100%;min-height:{{ block.settings.min_height }}px;border:0;border-radius:{{ radius }}px;background:{{ surface }};"
      loading="lazy"
      allow="clipboard-write"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  {% endif %}
</div>

{% schema %}
{
  "name": "Portal embed",
  "target": "section",
  "stylesheet": "aftersale.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-width warranty portal for this section. Colors below style this block on your storefront."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Accessible name",
      "default": "Warranty portal"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 280,
      "max": 1200,
      "step": 20,
      "default": 420
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0F172A"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Surface / background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
