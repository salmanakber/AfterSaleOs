{% comment %} Portal form embed — merchant controls columns + width in customizer {% endcomment %}

{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign accent = block.settings.accent_color | default: '#0f172a' %}
{% assign surface = block.settings.surface_color | default: 'transparent' %}
{% assign radius = block.settings.corner_radius | default: 12 %}
{% assign accent_q = accent | url_encode %}
{% render 'as-embed-layout' %}
{% assign embed_src = as_app_url | append: '/apps/aftersale/portal?shop=' | append: shop.permanent_domain | append: '&embed=1&theme=local&accent=' | append: accent_q | append: as_layout_qs %}
{% comment %} Pass theme login URL + current page so “Continue with Shopify” avoids redirect loops and returns here after login. {% endcomment %}
{% if routes.account_login_url != blank %}
  {% assign as_login_q = routes.account_login_url | url_encode %}
  {% assign embed_src = embed_src | append: '&shopify_login=' | append: as_login_q %}
{% endif %}
{% if request.path != blank %}
  {% assign as_return_q = request.path | url_encode %}
  {% assign embed_src = embed_src | append: '&return_to=' | append: as_return_q %}
{% endif %}
{% if customer and customer.email != blank %}
  {% assign as_email_q = customer.email | url_encode %}
  {% assign embed_src = embed_src | append: '&email=' | append: as_email_q %}
{% endif %}
{% if customer and customer.id %}
  {% assign embed_src = embed_src | append: '&logged_in_customer_id=' | append: customer.id %}
{% endif %}

<div
  class="as-embed-block as-embed-block--{{ as_cwidth }} as-embed-block--cols-{{ as_cols }}"
  {{ block.shopify_attributes }}
  data-as-embed
  style="--as-embed-radius: {{ radius }}px; --as-embed-surface: {{ surface }}; --as-embed-max: {{ as_max_w }};"
>
  {% if request.design_mode %}
    <div class="as-block-preview as-block-preview--form as-block-preview--cols-{{ as_cols }}" style="border-radius: {{ radius }}px; max-width: {{ as_max_w }};">
      <strong>Client portal · {% if as_cols == '1' %}1 column{% else %}2 columns{% endif %} · {{ as_cwidth }}</strong>
      <p>Customers sign in to activate warranties, view products, file claims, and track requests.</p>
      <div class="as-block-preview__grid as-block-preview__grid--{{ as_cols }}">
        <span class="as-block-preview__field">Activate warranty</span>
        <span class="as-block-preview__field">My products</span>
        <span class="as-block-preview__field">File a claim</span>
        <span class="as-block-preview__field">My requests</span>
      </div>
      <span class="as-block-preview__btn" style="background:{{ accent }};">Open client portal</span>
      <a class="as-block-preview__link" href="{{ embed_src }}" target="_blank" rel="noopener">Open live preview ↗</a>
    </div>
  {% else %}
    <iframe
      class="as-embed-block__frame"
      title="{{ block.settings.title | default: 'Warranty portal' }}"
      src="{{ embed_src }}"
      style="width:100%;max-width:{{ as_max_w }};min-height:{{ block.settings.min_height }}px;border:0;border-radius:{{ radius }}px;background:{{ surface }};margin-inline:auto;display:block;"
      loading="lazy"
      allow="clipboard-write"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  {% endif %}
</div>

{% schema %}
{
  "name": "Client portal",
  "target": "section",
  "stylesheet": "aftersale.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Customize how the warranty portal looks inside this section."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "form_columns",
      "label": "Form fields",
      "options": [
        { "value": "2", "label": "Two columns" },
        { "value": "1", "label": "One column" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Form width",
      "options": [
        { "value": "full", "label": "Full section width" },
        { "value": "wide", "label": "Wide (960px)" },
        { "value": "medium", "label": "Medium (720px)" },
        { "value": "compact", "label": "Compact (520px)" }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "form_style",
      "label": "Form style",
      "options": [
        { "value": "cards", "label": "Section cards" },
        { "value": "flat", "label": "Flat (minimal)" }
      ],
      "default": "cards"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 280,
      "max": 1200,
      "step": 20,
      "default": 480
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Accessible name",
      "default": "Warranty portal"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0F172A"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Surface / background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ]
}
{% endschema %}
