{% comment %}
  Warranty registration opt-in — product & cart.
  Theme editor → Add block → Apps → Warranty register card
{% endcomment %}

{% assign accent = block.settings.accent_color | default: '#1a1d26' %}
{% assign surface = block.settings.surface_color | default: '#ffffff' %}
{% assign radius = block.settings.corner_radius | default: 14 %}
{% assign style = block.settings.display_style | default: 'checkbox_card' %}
{% capture as_app_url %}{% render 'as-app-host', url: '' %}{% endcapture %}
{% assign as_app_url = as_app_url | strip %}
{% assign register_url = as_app_url | append: '/apps/aftersale/register?shop=' | append: shop.permanent_domain %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
  {% assign register_url = register_url | append: '&product=' | append: product_q %}
  {% assign register_url = register_url | append: '&product_id=' | append: product.id %}
  {% if product.selected_or_first_available_variant %}
    {% assign register_url = register_url | append: '&variant_id=' | append: product.selected_or_first_available_variant.id %}
  {% endif %}
{% endif %}

<div
  class="as-optin as-optin--{{ style }}"
  style="--as-optin-accent: {{ accent }}; --as-optin-surface: {{ surface }}; --as-optin-radius: {{ radius }}px;"
  {{ block.shopify_attributes }}
  data-as-optin
  data-as-style="{{ style }}"
  data-register-url="{{ register_url }}"
>
  {% if style == 'button' %}
    <a class="as-optin__btn" href="{{ register_url }}" data-as-optin-btn>
      <span class="as-optin__btn-icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none">
          <path d="M4 10.5 L8 14.5 L16 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="as-optin__btn-label">{{ block.settings.cta_label }}</span>
    </a>
    {% if block.settings.subtitle != blank %}
      <p class="as-optin__btn-sub">{{ block.settings.subtitle }}</p>
    {% endif %}
  {% elsif style == 'soft_banner' %}
    <div class="as-optin__banner">
      <div class="as-optin__banner-copy">
        <span class="as-optin__title">{{ block.settings.title }}</span>
        <span class="as-optin__sub">{{ block.settings.subtitle }}</span>
      </div>
      <a class="as-optin__cta as-optin__cta--inline" href="{{ register_url }}">
        {{ block.settings.cta_label }}
      </a>
    </div>
  {% else %}
    <label class="as-optin__card">
      <span class="as-optin__checkwrap">
        <input
          class="as-optin__checkbox"
          type="checkbox"
          name="attributes[aftersale_register_intent]"
          value="yes"
          data-as-optin-check
          {% if block.settings.default_checked %}checked{% endif %}
        />
        <span class="as-optin__box" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none">
            <path d="M3 8.2 L6.2 11.5 L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </span>
      <span class="as-optin__copy">
        <span class="as-optin__title">{{ block.settings.title }}</span>
        <span class="as-optin__sub">{{ block.settings.subtitle }}</span>
      </span>
    </label>

    <div class="as-optin__panel" data-as-optin-panel hidden>
      <p class="as-optin__hint">{{ block.settings.checked_hint }}</p>
      <a class="as-optin__cta" href="{{ register_url }}">
        {{ block.settings.cta_label }}
      </a>
    </div>
  {% endif %}
</div>

<script src="{{ 'as-optin.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Warranty register card",
  "target": "section",
  "stylesheet": "aftersale.css",
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "settings": [
    {
      "type": "select",
      "id": "display_style",
      "label": "Style",
      "options": [
        { "value": "checkbox_card", "label": "Checkbox card" },
        { "value": "soft_banner", "label": "Soft banner + button" },
        { "value": "button", "label": "Styled button" }
      ],
      "default": "checkbox_card"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Register this product for warranty"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Supporting text",
      "default": "Keep coverage handy after you buy. Free and takes under a minute."
    },
    {
      "type": "text",
      "id": "checked_hint",
      "label": "Text when checked",
      "default": "Great — open registration anytime. We’ll also note this on your cart."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Register for warranty"
    },
    {
      "type": "checkbox",
      "id": "default_checked",
      "label": "Checked by default (checkbox style)",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#1A1D26"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    }
  ]
}
{% endschema %}
