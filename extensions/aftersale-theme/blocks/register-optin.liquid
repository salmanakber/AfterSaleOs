{% comment %}
  Beautiful warranty registration opt-in for product pages.
  Merchants: Theme editor → Product page → Add block → Apps → AfterSale warranty opt-in
{% endcomment %}

{% assign accent = block.settings.accent_color | default: '#1a1d26' %}
{% assign register_url = '/apps/aftersale/register?shop=' | append: shop.permanent_domain %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
  {% assign register_url = register_url | append: '&product=' | append: product_q %}
  {% assign register_url = register_url | append: '&product_id=' | append: product.id %}
  {% if product.selected_or_first_available_variant %}
    {% assign register_url = register_url | append: '&variant_id=' | append: product.selected_or_first_available_variant.id %}
  {% endif %}
{% endif %}

<div
  class="as-optin"
  style="--as-optin-accent: {{ accent }};"
  {{ block.shopify_attributes }}
  data-as-optin
  data-register-url="{{ register_url }}"
>
  <label class="as-optin__card">
    <span class="as-optin__checkwrap">
      <input
        class="as-optin__checkbox"
        type="checkbox"
        name="attributes[aftersale_register_intent]"
        value="yes"
        data-as-optin-check
        {% if block.settings.default_checked %}checked{% endif %}
      />
      <span class="as-optin__box" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none">
          <path d="M3 8.2 L6.2 11.5 L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </span>
    <span class="as-optin__copy">
      <span class="as-optin__title">{{ block.settings.title }}</span>
      <span class="as-optin__sub">{{ block.settings.subtitle }}</span>
    </span>
  </label>

  <div class="as-optin__panel" data-as-optin-panel hidden>
    <p class="as-optin__hint">{{ block.settings.checked_hint }}</p>
    <a class="as-optin__cta" href="{{ register_url }}">
      {{ block.settings.cta_label }}
    </a>
  </div>
</div>

<script src="{{ 'as-optin.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Warranty register card",
  "target": "section",
  "stylesheet": "aftersale.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Register this product for warranty"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Check this box to keep coverage handy after you buy. Free and takes under a minute."
    },
    {
      "type": "text",
      "id": "checked_hint",
      "label": "Text when checked",
      "default": "Great — open registration anytime. We’ll also note this on your cart."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Register now"
    },
    {
      "type": "checkbox",
      "id": "default_checked",
      "label": "Checked by default",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#1A1D26"
    }
  ]
}
{% endschema %}
