{% comment %}
  Optional manual block — product & cart.
  Prefer App embed "Warranty opt-in (auto)".
  Checkbox only — does NOT navigate to the portal.
{% endcomment %}

{% assign accent = block.settings.accent_color | default: '#0f172a' %}
{% assign surface = block.settings.surface_color | default: '#ffffff' %}
{% assign radius = block.settings.corner_radius | default: 12 %}
{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign fee_api = as_app_url | append: '/api/public/branding' %}

<div
  class="as-optin as-optin--checkbox_card"
  style="--as-optin-accent: {{ accent }}; --as-optin-surface: {{ surface }}; --as-optin-radius: {{ radius }}px; width:100%;"
  {{ block.shopify_attributes }}
  data-as-optin
  data-as-style="checkbox_card"
  data-shop="{{ shop.permanent_domain }}"
  data-fee-api="{{ fee_api }}"
  data-checked-status="{{ block.settings.checked_hint | default: 'Warranty will be registered automatically when you complete checkout.' | escape }}"
>
  <div class="as-optin__card" data-as-optin-card>
    <span class="as-optin__checkwrap">
      <input
        id="as-optin-check-{{ block.id }}"
        class="as-optin__checkbox"
        type="checkbox"
        name="attributes[aftersale_register_intent]"
        value="yes"
        data-as-optin-check
        {% if block.settings.default_checked %}checked{% endif %}
      />
      <span class="as-optin__box" aria-hidden="true"></span>
    </span>
    <span class="as-optin__copy">
      <label class="as-optin__title" for="as-optin-check-{{ block.id }}">{{ block.settings.title }}</label>
      {% if block.settings.subtitle != blank %}
        <span class="as-optin__sub">{{ block.settings.subtitle }}</span>
      {% endif %}
      <span class="as-optin__fee" data-as-fee-note hidden></span>
    </span>
  </div>

  <div class="as-optin__panel as-optin__panel--confirm" data-as-optin-panel hidden>
    <p class="as-optin__status" data-as-optin-status role="status"></p>
  </div>
</div>

<script src="{{ 'as-optin.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Warranty register card",
  "target": "section",
  "stylesheet": "aftersale.css",
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a warranty checkbox at checkout. When shoppers check it, coverage is registered automatically after they buy."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Include warranty registration"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Supporting text",
      "default": "Add coverage to this order. If your store charges a fee, the price appears here and in your cart."
    },
    {
      "type": "text",
      "id": "checked_hint",
      "label": "Confirmation when checked",
      "default": "Warranty will be added with this order."
    },
    {
      "type": "checkbox",
      "id": "default_checked",
      "label": "Checked by default",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0F172A"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ]
}
{% endschema %}
