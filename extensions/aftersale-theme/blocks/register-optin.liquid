{% comment %}
  Optional manual block — product & cart.
  Prefer App embed "Warranty opt-in (auto)" so it appears without adding a block.
{% endcomment %}

{% assign accent = block.settings.accent_color | default: '#111111' %}
{% assign surface = block.settings.surface_color | default: 'transparent' %}
{% assign radius = block.settings.corner_radius | default: 8 %}
{% assign style = block.settings.display_style | default: 'checkbox_card' %}
{% assign as_app_url = 'https://aftersale.tidyflowapp.com' %}
{% assign register_url = as_app_url | append: '/apps/aftersale/register?shop=' | append: shop.permanent_domain %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
  {% assign register_url = register_url | append: '&product=' | append: product_q %}
  {% assign register_url = register_url | append: '&product_id=' | append: product.id %}
  {% if product.selected_or_first_available_variant %}
    {% assign register_url = register_url | append: '&variant_id=' | append: product.selected_or_first_available_variant.id %}
  {% endif %}
{% endif %}

<div
  class="as-optin as-optin--{{ style }}"
  style="--as-optin-accent: {{ accent }}; --as-optin-surface: {{ surface }}; --as-optin-radius: {{ radius }}px;"
  {{ block.shopify_attributes }}
  data-as-optin
  data-as-style="{{ style }}"
  data-register-url="{{ register_url }}"
>
  {% if style == 'button' %}
    <a class="as-optin__btn" href="{{ register_url }}" data-as-optin-btn>
      {{ block.settings.cta_label }}
    </a>
    {% if block.settings.subtitle != blank %}
      <p class="as-optin__btn-sub">{{ block.settings.subtitle }}</p>
    {% endif %}
  {% elsif style == 'soft_banner' %}
    <div class="as-optin__banner">
      <div class="as-optin__banner-copy">
        <span class="as-optin__title">{{ block.settings.title }}</span>
        {% if block.settings.subtitle != blank %}
          <span class="as-optin__sub">{{ block.settings.subtitle }}</span>
        {% endif %}
      </div>
      <a class="as-optin__cta as-optin__cta--inline" href="{{ register_url }}">
        {{ block.settings.cta_label }}
      </a>
    </div>
  {% else %}
    <label class="as-optin__card" for="as-optin-check-{{ block.id }}">
      <span class="as-optin__checkwrap">
        <input
          id="as-optin-check-{{ block.id }}"
          class="as-optin__checkbox"
          type="checkbox"
          name="attributes[aftersale_register_intent]"
          value="yes"
          data-as-optin-check
          {% if block.settings.default_checked %}checked{% endif %}
        />
        <span class="as-optin__box" aria-hidden="true"></span>
      </span>
      <span class="as-optin__copy">
        <span class="as-optin__title">{{ block.settings.title }}</span>
        {% if block.settings.subtitle != blank %}
          <span class="as-optin__sub">{{ block.settings.subtitle }}</span>
        {% endif %}
      </span>
    </label>

    <div class="as-optin__panel" data-as-optin-panel hidden>
      {% if block.settings.checked_hint != blank %}
        <p class="as-optin__hint">{{ block.settings.checked_hint }}</p>
      {% endif %}
      <a class="as-optin__cta" href="{{ register_url }}">
        {{ block.settings.cta_label }}
      </a>
    </div>
  {% endif %}
</div>

<script src="{{ 'as-optin.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Warranty register card",
  "target": "section",
  "stylesheet": "aftersale.css",
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Tip: enable App embeds → Warranty opt-in (auto) to show this next to Add to cart without placing a block."
    },
    {
      "type": "select",
      "id": "display_style",
      "label": "Style",
      "options": [
        { "value": "checkbox_card", "label": "Checkbox" },
        { "value": "soft_banner", "label": "Text + button" },
        { "value": "button", "label": "Button only" }
      ],
      "default": "checkbox_card"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Register this product for warranty"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Supporting text",
      "default": "Optional — keep coverage after you buy."
    },
    {
      "type": "text",
      "id": "checked_hint",
      "label": "Text when checked",
      "default": "You can register now or after checkout."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Register for warranty"
    },
    {
      "type": "checkbox",
      "id": "default_checked",
      "label": "Checked by default",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / button color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ]
}
{% endschema %}
