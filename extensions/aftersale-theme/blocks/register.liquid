{% comment %}
  AfterSale product registration block — hosted URL so the form always loads.
{% endcomment %}

{% capture as_app_url %}{% render 'as-app-host', url: block.settings.app_url %}{% endcapture %}
{% assign as_app_url = as_app_url | strip %}
{% assign product_q = '' %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
{% endif %}

<div class="as-register-block" {{ block.shopify_attributes }}>
  <div class="as-embed-mock as-embed-mock--compact">
    <div class="as-embed-mock__body">
      <strong>{{ block.settings.button_label | default: "Register for warranty" }}</strong>
      <p>Button opens the hosted registration form for this product.</p>
    </div>
  </div>
  <a
    class="as-register-block__btn"
    href="{{ as_app_url }}/apps/aftersale/register?shop={{ shop.permanent_domain }}{% if product %}&product={{ product_q }}&product_id={{ product.id }}{% if product.selected_or_first_available_variant %}&variant_id={{ product.selected_or_first_available_variant.id }}{% endif %}{% endif %}"
  >
    {{ block.settings.button_label | default: "Register for warranty" }}
  </a>
  {% if block.settings.show_lookup %}
    <p class="as-register-block__lookup">
      <a href="{{ as_app_url }}/apps/aftersale/portal?shop={{ shop.permanent_domain }}">
        {{ block.settings.lookup_label | default: "Look up your warranty" }}
      </a>
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "AfterSale register",
  "target": "section",
  "stylesheet": "aftersale.css",
  "enabled_on": {
    "templates": ["product", "page", "index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL (hosted AfterSale)",
      "default": "https://aftersale.tidyflowapp.com",
      "info": "Never use your .myshopify.com domain."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Register for warranty"
    },
    {
      "type": "checkbox",
      "id": "show_lookup",
      "label": "Show warranty lookup link",
      "default": true
    },
    {
      "type": "text",
      "id": "lookup_label",
      "label": "Lookup link label",
      "default": "Look up your warranty"
    }
  ]
}
{% endschema %}
