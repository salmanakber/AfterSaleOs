{% comment %}
  AfterSale product registration button — opens branded registration.
{% endcomment %}

{% capture as_app_url %}{% render 'as-app-host', url: '' %}{% endcapture %}
{% assign as_app_url = as_app_url | strip %}
{% assign accent = block.settings.accent_color | default: '#1a1d26' %}
{% assign product_q = '' %}
{% if product %}
  {% assign product_q = product.title | url_encode %}
{% endif %}

<div class="as-register-block" style="--as-btn-accent: {{ accent }};" {{ block.shopify_attributes }}>
  <a
    class="as-register-block__btn"
    href="{{ as_app_url }}/apps/aftersale/register?shop={{ shop.permanent_domain }}{% if product %}&product={{ product_q }}&product_id={{ product.id }}{% if product.selected_or_first_available_variant %}&variant_id={{ product.selected_or_first_available_variant.id }}{% endif %}{% endif %}"
  >
    {{ block.settings.button_label | default: "Register for warranty" }}
  </a>
  {% if block.settings.show_lookup %}
    <p class="as-register-block__lookup">
      <a href="{{ as_app_url }}/apps/aftersale/portal?shop={{ shop.permanent_domain }}">
        {{ block.settings.lookup_label | default: "Look up your warranty" }}
      </a>
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Warranty register button",
  "target": "section",
  "stylesheet": "aftersale.css",
  "enabled_on": {
    "templates": ["product", "page", "index", "cart"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Register for warranty"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#1A1D26"
    },
    {
      "type": "checkbox",
      "id": "show_lookup",
      "label": "Show warranty lookup link",
      "default": true
    },
    {
      "type": "text",
      "id": "lookup_label",
      "label": "Lookup link label",
      "default": "Look up your warranty"
    }
  ]
}
{% endschema %}
