{% comment %}
  Resolves hosted AfterSale app origin. Never use myshopify.com (iframes refuse to connect).
  Usage: {% render 'as-app-host', url: block.settings.app_url %}
{% endcomment %}
{%- assign raw = url | default: 'https://aftersale.tidyflowapp.com' | strip | replace: 'http://', 'https://' -%}
{%- if raw == blank or raw contains 'myshopify.com' or raw contains 'shopify.com/admin' -%}
  {%- assign raw = 'https://aftersale.tidyflowapp.com' -%}
{%- endif -%}
{%- assign host_parts = raw | split: '/' -%}
{%- if host_parts.size >= 3 -%}
https://{{ host_parts[2] }}
{%- else -%}
https://aftersale.tidyflowapp.com
{%- endif -%}
