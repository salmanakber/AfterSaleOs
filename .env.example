# =============================================================================
# AfterSale OS — copy to .env:  cp .env.example .env
# =============================================================================

APP_URL=http://localhost:3000
PORT=3000
ADMIN_URL=http://localhost:3001
ADMIN_PORT=3001

NEXT_PUBLIC_SHOPIFY_API_KEY=your_shopify_client_id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Shopify Partner app ─────────────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
# Minimum scopes for M0–M3. Request protected customer data + read_all_orders early.
SHOPIFY_SCOPES=read_products,read_orders,read_customers,write_draft_orders
SHOPIFY_API_VERSION=2025-01

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=aftersale
POSTGRES_PASSWORD=aftersale
POSTGRES_DB=aftersale
DATABASE_URL=postgresql://aftersale:aftersale@127.0.0.1:5432/aftersale

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Secrets (openssl rand -hex 32) ────────────────────────────────────────
ENCRYPTION_KEY=
ADMIN_JWT_SECRET=
ADMIN_SESSION_SECRET=
API_KEY_PEPPER=
TOKEN_ENCRYPTION_KEY=

# ─── Billing / email ─────────────────────────────────────────────────────────
SHOPIFY_BILLING_TEST=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com
RESEND_FROM_NAME=AfterSale OS

# ─── Files (S3-compatible) ───────────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=aftersale
S3_ACCESS_KEY=
S3_SECRET_KEY=
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# ─── Admin seed ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@aftersale.local
SEED_ADMIN_PASSWORD=changeme123

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
