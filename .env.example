# =============================================================================
# AfterSale OS — copy to .env:  cp .env.example .env
# =============================================================================

# Public domain (nginx/Caddy → this Node process)
APP_URL=https://aftersale.tidyflowapp.com
PORT=4500
HOST=0.0.0.0

# Super Admin is served on the SAME domain under /admin (not a second public port)
ADMIN_URL=https://aftersale.tidyflowapp.com/admin
NEXT_PUBLIC_ADMIN_BASE_PATH=/admin

# Internal only (gateway proxies these; do not expose in firewall)
WEB_INTERNAL_PORT=4502
ADMIN_INTERNAL_PORT=4501

NEXT_PUBLIC_SHOPIFY_API_KEY=your_shopify_client_id
NEXT_PUBLIC_APP_URL=https://aftersale.tidyflowapp.com

# ─── Shopify Partner app ─────────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=your_shopify_app_shared_secret_here
SHOPIFY_SCOPES=read_products,read_orders,read_customers,write_draft_orders
SHOPIFY_API_VERSION=2025-01

# ─── Database ────────────────────────────────────────────────────────────────
# If password contains @ or !, URL-encode them (%40 / %21)
DATABASE_URL=postgresql://aftersale:aftersale@127.0.0.1:5432/aftersale

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Secrets (openssl rand -hex 32) ────────────────────────────────────────
ENCRYPTION_KEY=
ADMIN_JWT_SECRET=
ADMIN_SESSION_SECRET=
API_KEY_PEPPER=
TOKEN_ENCRYPTION_KEY=

# ─── Billing / email ─────────────────────────────────────────────────────────
SHOPIFY_BILLING_TEST=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com
RESEND_FROM_NAME=AfterSale OS

# ─── Files ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# ─── Admin seed ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@aftersale.local
SEED_ADMIN_PASSWORD=changeme123

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
